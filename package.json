{
  "name": "kinkaramen-waiting",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "npm run fit-model && npm run validate-model",
    "typecheck": "tsc --noEmit",
    "fit-model": "node --experimental-strip-types scripts/fit-model.ts",
    "validate-model": "node --experimental-strip-types scripts/validate-model.ts"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
